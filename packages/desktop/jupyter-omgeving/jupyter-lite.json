{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "Open CalcSheet Studio",
    "exposeAppInBrowser": true,
    "enableMemoryStorage": true,
    "contentsStorageDrivers": ["memoryStorageDriver"],
    "settingsStorageDrivers": ["memoryStorageDriver"],
    "workspacesStorageDrivers": ["memoryStorageDriver"],
    "enableServiceWorkerCache": false,
    "disabledExtensions": [
      "@jupyterlab/apputils-extension:announcements",
      "@jupyterlite/application-extension:share-file",
      "@jupyterlab/javascript-extension:factory",
      "@jupyterlab/vega5-extension:factory"
    ],
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pyodideUrl": "./static/pyodide/pyodide.mjs",
        "disablePyPIFallback": true
      }
    }
  }
}
